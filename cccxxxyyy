// ---------------------------------------------------------------------------
// INVALIDATION LEVELS — split into two named plots so DOM scraping can tell
// which side is active without relying on color.
//
//   inv_up  -> fires when the up-trend invalidation line is being drawn
//              (linear_regression > 0, i.e. col_up regime)
//   inv_dn  -> fires when the down-trend invalidation line is being drawn
//              (linear_regression <= 0, i.e. col_dn regime)
//
// Both plots draw the SAME value (`points`) using the SAME linebr style and
// force_overlay flag as the original single plot. Only one of them will ever
// be non-na on a given bar. The on-chart appearance is unchanged.
//
// Legend markers: 🟢 for inv_up, 🔴 for inv_dn — these survive the DOM read
// and let the Python hook distinguish the two states via the existing
// ∅ -> emoji transition logic.
// ---------------------------------------------------------------------------

bool inv_up_active = not na(points) and linear_regression > 0
bool inv_dn_active = not na(points) and linear_regression <= 0

plot(ta.change(points) == 0 and inv_up_active ? points : na,
         title          = 'col_up',
         color          = color.from_gradient(linear_regression, 0, 1, color(na), col_up),
         linewidth      = 2,
         style          = plot.style_linebr,
         force_overlay  = true
         )

plot(ta.change(points) == 0 and inv_dn_active ? points : na,
         title          = 'col_dn',
         color          = color.from_gradient(linear_regression, -1, 0, col_dn, color(na)),
         linewidth      = 2,
         style          = plot.style_linebr,
         force_overlay  = true
         )

// Legend-visible markers so the Python hook can read which side is live.
