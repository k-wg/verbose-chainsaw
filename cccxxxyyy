long350 = ta.sma(close, 350)
long500 = ta.sma(close, 500)
plot(long350, color = #ff1010, title = 'ma_350', linewidth = 2)
plot(long500, color = #0088ff, title = ' ma_500', linewidth = 3)






///////////// RSI
RSIlength = input(7, title = 'RSI Period Length')
RSIoverSold = 50
RSIoverBought = 50
price = close
vrsi = ta.rsi(price, RSIlength)


///////////// Bollinger Bands
BBlength = input.int(200, minval = 5, title = 'Bollinger Period Length')
BBmult = 2.0
BBbasis = ta.sma(price, BBlength)
BBdev = BBmult * ta.stdev(price, BBlength)
BBupper = BBbasis + BBdev
BBlower = BBbasis - BBdev
source = close
buyEntry = ta.crossover(source, BBlower)
sellEntry = ta.crossunder(source, BBupper)
plot(BBbasis, color = color.new(color.aqua, 0), title = 'BBbasis')
p1 = plot(BBupper, color = color.new(color.silver, 0), title = 'BBupper')
p2 = plot(BBlower, color = color.new(color.silver, 0), title = 'BBlower')
fill(p1, p2, color = color.new(color.silver, 90))


///////////// Colors
switch1 = input(true, title = 'Enable Bar Color?')
switch2 = input(true, title = 'Enable Background Color?')
TrendColor = bool(RSIoverBought) and price[1] > BBupper and price < BBupper and BBbasis < BBbasis[1] ? color.red : bool(RSIoverSold) and price[1] < BBlower and price > BBlower and BBbasis > BBbasis[1] ? color.green : na
barcolor(switch1 ? TrendColor : na)
bgcolor(switch2 ? TrendColor : na)


///////////// RSI + Bollinger Bands Strategy
if not na(vrsi)


    if ta.crossover(vrsi, RSIoverSold) and ta.crossover(source, BBlower)
        strategy.order('RSI_BB_L', strategy.long, stop = BBlower, comment = 'RSI_BB_L')
    else
        strategy.cancel(id = 'RSI_BB_L')

    if ta.crossunder(vrsi, RSIoverBought) and ta.crossunder(source, BBupper)
        strategy.order('RSI_BB_S', strategy.short, stop = BBupper, comment = 'RSI_BB_S')
    else
        strategy.cancel(id = 'RSI_BB_S')

