//   Step 2: Wait for ma_350 > ma_500 AND close > BBupper -> confirm
//   Step 3: Wait for rsi_ma50 < 35 -> confirm
//   Step 4: Plot 🔔 at the 75th line
// =============================

// State variables
var int  snip142_state   = 0   // 0 = idle, 1 = armed, 2 = step2 confirmed
var bool snip142_trigger = false

// Reset trigger each bar
snip142_trigger := false

// Step 1 condition: snip74 fired AND invalidation level (col_down) > ma_500
bool snip142_step1 = snip74_trigger and linear_regression < 0 and points > long500

if snip142_state == 0
    // Step 1: Arm the system
    if snip142_step1
        snip142_state := 1
else if snip142_state == 1
    // Step 2: Wait for ma_350 > ma_500 AND close > BBupper -> confirm
    if long350 > long500 and close > BBupper
        snip142_state := 2
else if snip142_state == 2
    // Step 3: Wait for rsi_ma50 < 35 -> confirm and trigger
    if rsi_ma50 < 35
        snip142_state   := 0
        snip142_trigger := true
        lastSignalType  := "🔔_Snippet142"

// Plot 🔔 at the 75th line when triggered
plotchar(snip142_trigger ? 75 : na, "🔔", "🔔", location = location.absolute, color = color.red, size = size.small)






